# =================================================================
# Telegram Channel Cloner - Environment Configuration
# =================================================================
# Copy this file to .env or supply these variables in Portainer.
# NEVER commit real credentials, tokens, or passwords to Git.
# =================================================================

# The port exposed on the host machine
APP_PORT=8083

# Initial administrator credentials for web dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-secure-password

# Secret key used for JWT signing and AES-256/Fernet encryption of bot tokens at rest.
# Generate a strong 32-byte key using: openssl rand -base64 32
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars

# Database connection URL.
# Defaults to persistent SQLite file stored on the Docker volume /data.
# For external PostgreSQL, use: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:////data/cloner.db

# Maximum number of concurrent channel cloning jobs allowed to run simultaneously
MAX_CONCURRENT_JOBS=10

# Application log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
